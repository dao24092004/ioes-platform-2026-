# ============================================
# IOES - Git Ignore Rules
# ============================================

# =============================
# OS files
# =============================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# =============================
# IDEs
# =============================
# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/
# Hexagonal architecture: keep /port/out/ source folders (IntelliJ build output)
!**/port/out/

# VS Code (commit .vscode/settings.json but ignore workspace state)
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
*.code-workspace

# Eclipse
.project
.classpath
.settings/
.factorypath

# NetBeans
nbproject/private/
nbbuild/
dist/
nbdist/
.nb-gradle/

# =============================
# Node.js / Frontend
# =============================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# Build outputs
dist/
build/
.next/
.nuxt/
.vite/
.cache/
.parcel-cache/
.turbo/

# Nx
.nx/cache
.nx/workspace-data

# Coverage
coverage/
*.lcov
.nyc_output/

# Environment files
.env
.env.local
.env.development
.env.test
.env.production
.env.*.local
!.env.example

# Logs
logs/
*.log
pnpm-lock.yaml
package-lock.json
yarn.lock
bun.lockb

# =============================
# Java / Maven / Gradle
# =============================
target/
*.class
*.jar
*.war
*.ear
hs_err_pid*
replay_pid*

# Maven
.mvn/
mvnw
mvnw.cmd

# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/build/
!**/src/test/**/build/

# Spring Boot
spring-boot-devtools.properties

# =============================
# Python
# =============================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
env/
ENV/
.venv/
env.bak/
venv.bak/

# Poetry
.python-version

# Jupyter
.ipynb_checkpoints
profile_default/
ipython_config.py

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# pytest
.pytest_cache/
.tox/

# celery
celerybeat-schedule
celerybeat.pid

# SageMath parsed files
*.sage.py

# Spyder
.spyderproject
.spyproject

# Rope
.ropeproject

# mkdocs
/site

# pyenv
.python-version

# Migrations (auto-generated)
**/migrations/__pycache__/

# Model files (large)
*.h5
*.hdf5
*.pb
*.onnx
*.pt
*.pth
*.pkl
*.joblib
data/raw/
data/processed/
models/checkpoints/
models/exports/

# =============================
# Docker
# =============================
docker-compose.override.yml
docker-compose.local.yml

# =============================
# Kubernetes / Helm
# =============================
**/charts/*.tgz
**/charts/*/charts/
.kube/
.kubectl/

# =============================
# Terraform
# =============================
.terraform/
*.tfstate
*.tfstate.*
*.tfstate.backup
.terraform.lock.hcl
.terraform.tfstate.lock.info
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# =============================
# Database
# =============================
*.sql.bak
*.db
*.sqlite
*.sqlite3

# =============================
# Secrets & Keys
# =============================
*.pem
*.key
*.crt
*.cert
*.p12
*.pfx
secrets/
secrets.yaml
secrets.yml

# Service Account files
**/gcp-service-account*.json
**/aws-credentials
**/.aws/credentials
**/.gcp/keyfile.json

# =============================
# Test artifacts
# =============================
test-results/
playwright-report/
playwright/.cache/
k6-results/
.load-test-results/
coverage/lcov-report/

# =============================
# Documentation builds
# =============================
docs/_build/
docs/site/
site/

# =============================
# TypeScript build artifacts (NEVER commit .js/.d.ts trong src/)
# =============================
*.tsbuildinfo
**/src/**/*.js
**/src/**/*.js.map
**/src/**/*.d.ts
!**/src/**/*.d.ts.bak

# =============================
# Generated files
# =============================
**/generated/
**/openapi-generated/
*.generated.*
.openapi-generator/

# =============================
# Temporary files
# =============================
tmp/
temp/
*.tmp
*.swp
*.swo
*~

# =============================
# OS specific
# =============================
# Windows
$RECYCLE.BIN/
*.lnk

# Linux
.fuse_hidden*
.Trash-*

# macOS
.AppleDouble
.LSOverride

# =============================
# Editor backup files
# =============================
*~
*.bak
*.backup
*.orig
*.rej

# =============================
# Personal files
# =============================
TODO.md
NOTES.md
personal/
drafts/
