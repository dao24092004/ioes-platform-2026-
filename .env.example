# ============================================
# IOES - Environment Variables Template
# Copy this file to .env and fill in the values
# ============================================

# ============================================
# APPLICATION SETTINGS
# ============================================
APP_ENV=local
APP_NAME=ioes
APP_VERSION=1.0.0

# ============================================
# DOMAIN CONFIGURATION
# ============================================
DOMAIN_API=http://localhost:8080
DOMAIN_WEB=http://localhost:3000
DOMAIN_FRONTEND=http://localhost:3000

# ============================================
# POSTGRESQL CONFIGURATION
# ============================================
POSTGRES_HOST=localhost
# Host port when connecting from outside Docker. The Postgres container listens
# on 5432 internally, but Docker maps it to 5433 on the host because some
# distros/Ubuntu install a local Postgres that already binds 5432.
POSTGRES_PORT=5433
POSTGRES_USER=ioes
POSTGRES_PASSWORD=ioes_dev_password
POSTGRES_DB=postgres

# Database names per service
AUTH_DB_NAME=ioes_auth
CONTENT_DB_NAME=ioes_content
EXAM_DB_NAME=ioes_exam
ANALYTICS_DB_NAME=ioes_analytics
BLOCKCHAIN_DB_NAME=ioes_blockchain
NOTIFICATION_DB_NAME=ioes_notification
AI_DB_NAME=ioes_ai

# ============================================
# REDIS CONFIGURATION
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# ============================================
# MONGODB CONFIGURATION
# ============================================
# Cluster-level (root) credentials — only used by ops/admin tooling
# (mongo-express UI, mongodb-exporter). Application services must use the
# per-service MONGO_*_USER / MONGO_*_PASSWORD below, NEVER the root.
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_REPLICA_SET=rs0
MONGO_ROOT_USER=ioes
MONGO_ROOT_PASSWORD=ioes_dev_password

# Per-service credentials (readWrite on their own DB only).
# Pattern: MONGO_<SERVICE>_USER / MONGO_<SERVICE>_PASSWORD.
# These are created by infrastructure/mongo-init/01-init-databases.js on first
# MongoDB boot.
MONGO_DB_CONTENT=ioes_content
MONGO_CONTENT_USER=ioes_content_user
MONGO_CONTENT_PASSWORD=ioes_content_dev_password

MONGO_DB_ANALYTICS=ioes_analytics
MONGO_ANALYTICS_USER=ioes_analytics_user
MONGO_ANALYTICS_PASSWORD=ioes_analytics_dev_password

# Used by Spring config: mongodb://user:pass@host:port/db?replicaSet=rs0
MONGO_AUTH_SOURCE=admin

# ============================================
# KAFKA CONFIGURATION
# ============================================
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_ZOOKEEPER_CONNECT=localhost:2181
KAFKA_CONSUMER_GROUP=ioes-consumers

# Kafka Topics
KAFKA_TOPIC_USER_REGISTERED=auth.user.registered
KAFKA_TOPIC_USER_LOGGED_IN=auth.user.logged_in
KAFKA_TOPIC_COURSE_CREATED=content.course.created
KAFKA_TOPIC_COURSE_ENROLLED=content.course.enrolled
KAFKA_TOPIC_EXAM_SUBMITTED=exam.submission.submitted
KAFKA_TOPIC_EXAM_GRADED=exam.submission.graded
KAFKA_TOPIC_CERTIFICATE_ISSUED=blockchain.certificate.issued

# ============================================
# MINIO / S3 CONFIGURATION
# ============================================
MINIO_ENDPOINT=http://localhost:9002
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio123
MINIO_BUCKET_MEDIA=ioes-media
MINIO_BUCKET_CERTIFICATES=ioes-certificates
MINIO_BUCKET_PROCTORING=ioes-proctoring

# ============================================
# MILVUS (Vector DB) CONFIGURATION
# ============================================
MILVUS_HOST=localhost
MILVUS_PORT=19530

# ============================================
# JWT / AUTHENTICATION CONFIGURATION
# ============================================
JWT_SECRET=change-this-to-a-very-long-random-string-at-least-256-bits
JWT_ACCESS_TOKEN_EXPIRATION=900000      # 15 minutes in milliseconds
JWT_REFRESH_TOKEN_EXPIRATION=604800000  # 7 days in milliseconds
JWT_ISSUER=ioes-platform

# ============================================
# OAUTH2 CONFIGURATION
# ============================================
# Google OAuth2
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH2_REDIRECT_URI=http://localhost:3000/auth/oauth2/callback

# GitHub OAuth2
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Microsoft OAuth2
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ============================================
# EMAIL CONFIGURATION (SMTP)
# ============================================
# For local development, use MailHog
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@ioes.local

# Production SMTP (example)
# MAIL_HOST=smtp.sendgrid.net
# MAIL_PORT=587
# MAIL_USERNAME=apikey
# MAIL_PASSWORD=your-sendgrid-api-key
# MAIL_FROM=noreply@ioes.com

# ============================================
# SMS CONFIGURATION (Optional)
# ============================================
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ============================================
# LLM / AI CONFIGURATION
# ============================================
LLM_PROVIDER=openai  # openai | azure | local

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.7

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# Local LLM (vLLM)
LOCAL_LLM_ENDPOINT=http://localhost:8080/v1
LOCAL_LLM_MODEL=llama-3.1-8b

# GPU Configuration
GPU_ENABLED=false
CUDA_VISIBLE_DEVICES=0

# ============================================
# BLOCKCHAIN CONFIGURATION
# ============================================
BLOCKCHAIN_NETWORK=polygon  # polygon | ethereum | localhost
BLOCKCHAIN_RPC_URL=
BLOCKCHAIN_PRIVATE_KEY=
BLOCKCHAIN_CONTRACT_ADDRESS=
IPFS_HOST=localhost
IPFS_PORT=5001
IPFS_GATEWAY=https://ipfs.io/ipfs/

# ============================================
# OBSERVABILITY CONFIGURATION
# ============================================
# Prometheus
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_PORT=3001

# Jaeger
JAEGER_HOST=localhost
JAEGER_PORT=16686

# ============================================
# ADMIN TOOLS CONFIGURATION
# ============================================
PGADMIN_EMAIL=admin@ioes.com
PGADMIN_PASSWORD=admin

# ============================================
# SPRING CLOUD CONFIG SERVER
# ============================================
CONFIG_SERVER_USER=config-server
CONFIG_SERVER_PASSWORD=config-server-password
CONFIG_GIT_URI=https://github.com/your-org/ioes-config.git
CONFIG_GIT_BRANCH=main
CONFIG_GIT_USERNAME=
CONFIG_GIT_TOKEN=

# ============================================
# API GATEWAY CONFIGURATION
# ============================================
API_GATEWAY_URL=http://localhost:8080
API_GATEWAY_RATE_LIMIT=100
API_GATEWAY_RATE_LIMIT_WINDOW=60

# ============================================
# CORS CONFIGURATION
# ============================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_MAX_AGE=3600

# ============================================
# LOGGING CONFIGURATION
# ============================================
LOG_LEVEL=DEBUG
LOG_FORMAT=json

# ============================================
# RESILIENCE CONFIGURATION
# ============================================
CIRCUIT_BREAKER_ENABLED=true
RESILIENT_RETRY_ATTEMPTS=3
RESILIENT_RETRY_DELAY=1000

# ============================================
# DEVELOPMENT / DEBUG
# ============================================
DEBUG_MODE=true
DEBUG_PORT=5005
JAVA_DEBUG_SUSPEND=n
