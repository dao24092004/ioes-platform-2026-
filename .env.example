# Node.js version
20

# ============================================
# Environment Configuration Example
# Copy to .env and fill in actual values
# ============================================

# =============================
# General
# =============================
NODE_ENV=development
LOG_LEVEL=debug
APP_VERSION=0.1.0

# =============================
# Frontend (apps/web/.env)
# =============================
VITE_API_BASE_URL=http://localhost:8080
VITE_WS_BASE_URL=ws://localhost:8080
VITE_SENTRY_DSN=
VITE_GOOGLE_ANALYTICS_ID=
VITE_GA4_MEASUREMENT_ID=

# =============================
# API Gateway
# =============================
API_GATEWAY_PORT=8080
EUREKA_SERVER_URL=http://discovery-service:9999/eureka
CONFIG_SERVER_URL=http://config-server:8888

# =============================
# Discovery Service (Eureka)
# =============================
EUREKA_PORT=9999
EUREKA_DEFAULT_ZONE=http://discovery-service:9999/eureka/

# =============================
# Auth Service
# =============================
AUTH_SERVICE_PORT=9000
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-256-bits
JWT_ACCESS_TOKEN_EXPIRATION=900000          # 15 minutes
JWT_REFRESH_TOKEN_EXPIRATION=604800000      # 7 days
JWT_ISSUER=ioes
BCRYPT_STRENGTH=12

# OAuth2
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# =============================
# Database
# =============================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=ioes
POSTGRES_PASSWORD=ioes_dev_password
POSTGRES_DB_AUTH=ioes_auth
POSTGRES_DB_CONTENT=ioes_content
POSTGRES_DB_EXAM=ioes_exam
POSTGRES_DB_ANALYTICS=ioes_analytics
POSTGRES_DB_BLOCKCHAIN=ioes_blockchain
POSTGRES_POOL_MAX=50
POSTGRES_POOL_MIN=10

# =============================
# Redis
# =============================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CLUSTER_ENABLED=false
REDIS_CLUSTER_NODES=redis-cluster:6379

# =============================
# MongoDB
# =============================
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_USER=ioes
MONGODB_PASSWORD=ioes_dev_password
MONGODB_DATABASE=ioes_content

# =============================
# Kafka
# =============================
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=ioes
KAFKA_GROUP_ID=ioes-consumers
KAFKA_TOPIC_EXAM_EVENTS=exam.events
KAFKA_TOPIC_GRADING=grading.events
KAFKA_TOPIC_USER_EVENTS=user.events
KAFKA_TOPIC_BLOCKCHAIN=blockchain.events

# =============================
# MinIO / S3
# =============================
MINIO_ENDPOINT=localhost:9000
MINIO_PORT=9000
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=minio123
MINIO_BUCKET_COURSES=ioes-courses
MINIO_BUCKET_AVATARS=ioes-avatars
MINIO_BUCKET_CERTIFICATES=ioes-certificates
MINIO_BUCKET_PROCTORING=ioes-proctoring

# =============================
# Milvus (Vector DB)
# =============================
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_USER=
MILVUS_PASSWORD=
MILVUS_DB_NAME=ioes

# =============================
# AI Services
# =============================
# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Google Gemini (fallback)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-pro

# HuggingFace
HUGGINGFACE_API_KEY=

# Model serving
MODEL_SERVING_URL=http://localhost:9101
LLM_SERVING_URL=http://localhost:9102
VISION_SERVING_URL=http://localhost:9103

# =============================
# Blockchain
# =============================
# Polygon
POLYGON_RPC_URL=https://rpc-mumbai.maticvigil.com
POLYGON_NETWORK=mumbai                                  # mainnet | mumbai
POLYGON_CHAIN_ID=80001
CONTRACT_PRIVATE_KEY=
CONTRACT_DEPLOYER_ADDRESS=

# The Graph
GRAPH_NODE_URL=https://api.thegraph.com/subgraphs/name/ioes

# IPFS
IPFS_API_URL=https://ipfs.infura.io:5001
IPFS_PROJECT_ID=
IPFS_PROJECT_SECRET=

# =============================
# Email (SendGrid)
# =============================
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@ioes.com
SENDGRID_FROM_NAME=IOES
MAILHOG_HOST=localhost
MAILHOG_PORT=1025

# =============================
# SMS (Twilio)
# =============================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# =============================
# Notification (Push)
# =============================
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# =============================
# Observability
# =============================
# Prometheus
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# Grafana
GRAFANA_URL=http://localhost:3001
GRAFANA_API_KEY=

# Jaeger
JAEGER_AGENT_HOST=localhost
JAEGER_AGENT_PORT=6831
JAEGER_SERVICE_NAME=ioes

# Datadog
DD_API_KEY=
DD_APP_KEY=
DD_SERVICE=ioes
DD_ENV=development
DD_VERSION=0.1.0

# Sentry
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# =============================
# Rate Limiting
# =============================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100                  # requests per minute
RATE_LIMIT_BURST=200

# =============================
# CORS
# =============================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS

# =============================
# File Upload
# =============================
MAX_FILE_SIZE=524288000                  # 500MB in bytes
ALLOWED_FILE_TYPES=pdf,mp4,jpg,jpeg,png,gif,webp,doc,docx

# =============================
# Security
# =============================
CORS_ENABLED=true
CSRF_ENABLED=true
RATE_LIMIT_ENABLED=true
ENCRYPTION_KEY=your-32-byte-aes-256-key-here
ENCRYPTION_ALGORITHM=AES-256-GCM

# =============================
# Feature Flags
# =============================
FEATURE_BLOCKCHAIN_ENABLED=true
FEATURE_PROCTORING_ENABLED=true
FEATURE_AI_LEARNING_PATH=true
FEATURE_VISION_ATTENTION=true
FEATURE_RECOMMENDATION=true

# =============================
# CDN
# =============================
CDN_BASE_URL=https://cdn.ioes.com
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_KEY=

# =============================
# Logging
# =============================
LOG_FORMAT=json                          # json | text
LOG_LEVEL=debug
LOG_INCLUDE_STACKTRACE=true

# =============================
# Development flags
# =============================
DEV_SEED_DATA=true
DEV_SHOW_SWAGGER=true
DEV_ENABLE_HOT_RELOAD=true
