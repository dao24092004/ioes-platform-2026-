              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"questionText\": \"Write a function that returns the sum of two numbers\",\n  \"questionType\": \"coding\",\n  \"difficulty\": \"easy\",\n  \"points\": 20,\n  \"language\": \"python\",\n  \"topicId\": \"{{TOPIC_ID}}\",\n  \"estimatedTimeSeconds\": 300,\n  \"testCases\": [\n    { \"input\": \"1, 2\", \"expectedOutput\": \"3\", \"isSample\": true, \"points\": 5 },\n    { \"input\": \"0, 0\", \"expectedOutput\": \"0\", \"isSample\": false, \"points\": 5 },\n    { \"input\": \"-1, 1\", \"expectedOutput\": \"0\", \"isSample\": false, \"points\": 5 },\n    { \"input\": \"100, 200\", \"expectedOutput\": \"300\", \"isSample\": false, \"points\": 5 }\n  ]\n}"
            },
            "url": {
