<?xml version="1.0" encoding="UTF-8"?>
<!--
  Default Logback config for IOES Java services.

  - JSON output in production (LOG_FORMAT=json)
  - Pretty console in dev (LOG_FORMAT=console)

  Add `logstash-logback-encoder` to a service's pom.xml to enable JSON.
  We default to plain PatternLayout to avoid an extra dep at this layer.
-->
<configuration scan="false">

    <springProperty scope="context" name="appName" source="spring.application.name" defaultValue="ioes-service"/>
    <property name="LOG_FORMAT" value="${LOG_FORMAT:-json}"/>
    <property name="LOG_LEVEL" value="${LOG_LEVEL:-INFO}"/>

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>
                %d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [${appName},%X{traceId:-},%X{requestId:-}] %logger{36} - %msg%n
            </pattern>
        </encoder>
    </appender>

    <logger name="com.ioes" level="DEBUG"/>
    <logger name="org.springframework.kafka" level="INFO"/>
    <logger name="org.hibernate.SQL" level="INFO"/>
    <logger name="org.springframework.security" level="INFO"/>
    <logger name="org.springframework.web" level="INFO"/>
    <logger name="com.netflix" level="WARN"/>
    <logger name="reactor.netty" level="INFO"/>

    <root level="${LOG_LEVEL}">
        <appender-ref ref="STDOUT"/>
    </root>

</configuration>
