{
  "name": "ioes-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Intelligent Online Examination System - Monorepo",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "nx": "nx",
    "start": "nx run-many --target=serve --all",
    "build": "nx run-many --target=build --all",
    "test": "nx run-many --target=test --all",
    "lint": "nx run-many --target=lint --all",
    "format": "nx format:write",
    "format:check": "nx format:check",
    "graph": "nx graph",
    "affected": "nx affected",
    "dev:web": "nx serve web",
    "dev:backend": "nx run-many --target=serve --projects=tag:backend",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@nx/workspace": "^17.2.0",
    "@nx/node": "^17.2.0",
    "@nx/react": "^17.2.0",
    "@nx/eslint": "^17.2.0",
    "@nx/jest": "^17.2.0",
    "@nx/vite": "^17.2.0",
    "@nx/web": "^17.2.0",
    "@nxlv/python": "^20.15.0",
    "nx": "^17.2.0",
    "typescript": "~5.3.0",
    "prettier": "^3.1.0",
    "eslint": "^8.55.0",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": ["eslint --fix", "prettier --write"],
    "*.{java}": ["mvn spotless:apply"],
    "*.{py}": ["black .", "isort ."],
    "*.md": ["prettier --write"],
    "*.{json,yml,yaml}": ["prettier --write"]
  },
  "packageManager": "pnpm@9.0.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*",
    "libs/*"
  ]
}
