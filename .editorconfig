root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 100

[*.md]
trim_trailing_whitespace = false
max_line_length = 120

[*.{java}]
indent_size = 4
max_line_length = 120

[*.{py}]
indent_size = 4
max_line_length = 100

[*.go]
indent_size = tab

[*.{yml,yaml}]
indent_size = 2

[Makefile]
indent_style = tab

[*.{sql}]
indent_size = 2

[*.tf]
indent_size = 2
