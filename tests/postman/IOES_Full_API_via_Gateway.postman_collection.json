{
  "info": {
    "name": "IOES Full API - via Gateway 8080",
    "description": "Postman collection for testing all services via API Gateway (port 8080).\n\n## Flow\n1. Login để lấy token từ auth-service\n2. Dùng token gọi các services khác qua gateway\n\n## Routes\n- Auth: /api/auth/*\n- Question Bank: /api/question-bank/*\n- Exam Attempts: /api/v1/exam-attempts/*\n- Notification: /api/notifications/*",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "GATEWAY_URL",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "TOKEN",
      "value": "",
      "type": "string"
    },
    {
      "key": "REFRESH_TOKEN",
      "value": "",
      "type": "string"
    },
    {
      "key": "USER_ID",
      "value": "",
      "type": "string"
    },
    {
      "key": "EXAM_ID",
      "value": "00000000-0000-4000-8000-000000000aaa",
      "type": "string"
    },
    {
      "key": "TOPIC_ID",
      "value": "00000000-0000-4000-8000-000000000001",
      "type": "string"
    },
    {
      "key": "QUESTION_ID",
      "value": "",
      "type": "string"
    },
    {
      "key": "ATTEMPT_ID",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{TOKEN}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "00 - Setup",
      "item": [
        {
          "name": "Health Check - Gateway",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Gateway is healthy', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{GATEWAY_URL}}/actuator/health",
              "host": ["{{GATEWAY_URL}}"],
              "path": ["actuator", "health"]
            },
            "description": "Check API Gateway health"
          },
          "response": []
        }
      ]
    },
    {
      "name": "01 - AUTH (via Gateway)",
      "item": [
        {
          "name": "Login - Student",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "",
                  "if (jsonData.data && jsonData.data.accessToken) {",
                  "    pm.collectionVariables.set('TOKEN', jsonData.data.accessToken);",
                  "}",
                  "if (jsonData.data && jsonData.data.refreshToken) {",
                  "    pm.collectionVariables.set('REFRESH_TOKEN', jsonData.data.refreshToken);",
                  "}",
                  "if (jsonData.data && jsonData.data.user && jsonData.data.user.id) {",
                  "    pm.collectionVariables.set('USER_ID', jsonData.data.user.id);",
                  "}",
                  "",
                  "pm.test('Login successful', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(jsonData.data.accessToken).to.be.a('string');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"student@ioes.com\",\n    \"password\": \"Test@123\"\n}"
            },
            "url": {
              "raw": "{{GATEWAY_URL}}/api/auth/login",
              "host": ["{{GATEWAY_URL}}"],
              "path": ["api", "auth", "login"]
