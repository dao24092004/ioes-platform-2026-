    {
      "name": "04 - EXAM ATTEMPTS (via Gateway)",
      "item": [
        {
          "name": "Start Attempt",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.attemptId) {",
                  "    pm.collectionVariables.set('ATTEMPT_ID', jsonData.data.attemptId);",
                  "}",
                  "",
                  "pm.test('Attempt started', function () {",
                  "  pm.response.to.have.status(201);",
                  "  pm.expect(jsonData.success).to.be.true;",
                  "  pm.expect(jsonData.data.attemptId).to.be.a('string');",
                  "  pm.expect(jsonData.data.deadlineEpochMs).to.be.a('number');",
                  "});",
                  "",
                  "var deadline = pm.response.json().data.deadlineEpochMs;",
                  "var now = Date.now();",
                  "var durationSec = Math.ceil((deadline - now) / 1000);",
                  "console.log('Attempt deadline:', new Date(deadline).toISOString());",
                  "console.log('Duration:', durationSec, 'seconds');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{TOKEN}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"examId\": \"{{EXAM_ID}}\"\n}"
            },
