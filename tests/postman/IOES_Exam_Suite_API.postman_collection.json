  },
  "variable": [
    {
      "key": "BASE_URL",
      "value": "http://localhost:9005",
      "type": "string"
    },
    {
      "key": "TOKEN",
      "value": "Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
      "type": "string"
    },
    {
      "key": "STUDENT_USER_ID",
      "value": "00000000-0000-4000-8000-000000000001",
      "type": "string"
    },
    {
      "key": "INSTRUCTOR_USER_ID",
      "value": "00000000-0000-4000-8000-000000000002",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{TOKEN}}",
        "type": "string"
      }
    ]
  },
