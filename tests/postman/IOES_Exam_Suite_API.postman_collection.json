                    {
                      "key": "questionType",
                      "value": "",
                      "description": "Filter by type (multiple_choice, true_false, etc.)"
                    },
                    {
                      "key": "topicId",
                      "value": "",
                      "description": "Filter by topic UUID"
                    },
                    {
                      "key": "limit",
                      "value": "10",
                      "description": "Max results (default 20)"
                    },
                    {
                      "key": "offset",
                      "value": "0",
                      "description": "Pagination offset"
                    }
                  ]
