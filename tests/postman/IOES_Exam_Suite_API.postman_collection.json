              "request": {
                "method": "PATCH",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{TOKEN}}"
                  },
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "If-Match",
                    "value": "1",
                    "description": "Version for optimistic locking"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"questionText\": \"Updated question text\",\n  \"points\": 15\n}"
                },
                "url": {
                  "raw": "{{BASE_URL}}/question-bank/questions/:id",
                  "host": ["{{BASE_URL}}"],
                  "path": ["question-bank", "questions", ":id"]
                },
                "description": "Update question. Uses optimistic locking via If-Match header."
              },
              "response": []
