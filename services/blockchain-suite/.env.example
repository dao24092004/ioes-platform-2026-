# ============================================
# Blockchain Suite Environment Configuration
# Copy to .env for local development
# ============================================

# Application
NODE_ENV=development
APP_NAME=blockchain-suite
APP_PORT=9200
APP_HOST=0.0.0.0
APP_VERSION=1.0.0

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=ioes_blockchain
DB_PASSWORD=ioes_dev_password
DB_NAME=ioes_blockchain
DB_POOL_MIN=2
DB_POOL_MAX=10

# Redis (for cache / nonces)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=blockchain-suite
KAFKA_GROUP_ID=blockchain-suite

# JWT (must match auth-service)
JWT_SECRET=ioes-jwt-secret-key-must-be-at-least-256-bits-long-for-hs256-signing-algorithm
JWT_ALGORITHM=HS256

# Blockchain network
BLOCKCHAIN_NETWORK=localhost           # localhost | polygon | ethereum | sepolia
BLOCKCHAIN_RPC_URL=http://localhost:8545
BLOCKCHAIN_PRIVATE_KEY=
BLOCKCHAIN_CONTRACT_ADDRESS=
BLOCKCHAIN_CHAIN_ID=31337

# IPFS (for certificate metadata)
IPFS_HOST=localhost
IPFS_PORT=5001
IPFS_GATEWAY=https://ipfs.io/ipfs/

# Service URLs
API_GATEWAY_URL=http://localhost:8080
AUTH_SERVICE_URL=http://localhost:9000
CONTENT_SERVICE_URL=http://localhost:9001
EXAM_SERVICE_URL=http://localhost:9005

# Logging
LOG_LEVEL=DEBUG
LOG_FORMAT=json

# Tracing
OTLP_ENDPOINT=http://localhost:4317
