# ============================================
# Exam Suite Environment Configuration
# Copy to .env for local development
# ============================================

# Application
NODE_ENV=development
APP_NAME=exam-suite
APP_PORT=9005
APP_HOST=0.0.0.0
APP_VERSION=1.0.0

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=ioes_exam
DB_PASSWORD=ioes_dev_password
DB_NAME=ioes_exam
DB_POOL_MIN=5
DB_POOL_MAX=20

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=ioes:exam:

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=exam-suite
KAFKA_GROUP_ID=exam-suite

# JWT (must match auth-service)
JWT_SECRET=ioes-jwt-secret-key-must-be-at-least-256-bits-long-for-hs256-signing-algorithm
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# WebSocket / Socket.IO
WS_PORT=9006
WS_CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Logging
LOG_LEVEL=DEBUG
LOG_FORMAT=json

# Service URLs (for inter-service REST)
AUTH_SERVICE_URL=http://localhost:9000
CONTENT_SERVICE_URL=http://localhost:9001
NOTIFICATION_SERVICE_URL=http://localhost:9009
ANALYTICS_SERVICE_URL=http://localhost:9004
API_GATEWAY_URL=http://localhost:8080

# Tracing
OTLP_ENDPOINT=http://localhost:4317

# Feature flags
FEATURE_PROCTORING_ENABLED=true
FEATURE_AUTO_GRADING_ENABLED=true
