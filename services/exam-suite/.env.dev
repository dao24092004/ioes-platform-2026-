# Dev environment cho exam-suite — copy thành .env để dùng
# KHÔNG commit file .env thật

# Service
NODE_ENV=development
APP_NAME=exam-suite
APP_PORT=9005
WS_PORT=9006
WS_PUBLIC_URL=ws://localhost:9005

# Dev mode — bật các tính năng bypass để test Postman không cần gateway/auth
DEV_AUTH_BYPASS=true
DEV_MOCK_CONTENT_SERVICE=true
TYPEORM_SYNCHRONIZE=true

# Postgres
DB_HOST=localhost
DB_PORT=5433
DB_USER=ioes
DB_PASSWORD=ioes_dev_password
DB_NAME=ioes_exam

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_KEY_PREFIX=ioes:exam:

# Kafka (để trống host nếu không chạy → service vẫn start, chỉ log warn)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CLIENT_ID=exam-suite
KAFKA_GROUP_ID=exam-suite

# JWT (dev only — không dùng khi DEV_AUTH_BYPASS=true)
JWT_SECRET=ioes-jwt-secret-key-must-be-at-least-256-bits-long-for-hs256-signing-algorithm

# Service URLs (không dùng khi DEV_MOCK_CONTENT_SERVICE=true)
AUTH_SERVICE_URL=http://localhost:9000
CONTENT_SERVICE_URL=http://localhost:9001
NOTIFICATION_SERVICE_URL=http://localhost:9009
ANALYTICS_SERVICE_URL=http://localhost:9004
API_GATEWAY_URL=http://localhost:8080

# Logging
LOG_LEVEL=DEBUG
LOG_FORMAT=json

# Feature flags
FEATURE_PROCTORING_ENABLED=true
FEATURE_AUTO_GRADING_ENABLED=true