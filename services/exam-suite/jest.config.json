{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "src",
  "testRegex": ".*\\.spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "collectCoverageFrom": ["**/*.(t|j)s"],
  "coverageDirectory": "./coverage",
  "testEnvironment": "node",
  "moduleNameMapper": {
    "^@ioes/common-node$": "<rootDir>/../libs/common-node/src/index.ts",
    "^@ioes/common-node/(.*)$": "<rootDir>/../libs/common-node/src/$1"
  }
}