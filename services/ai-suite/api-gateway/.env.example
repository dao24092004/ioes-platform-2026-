# ai-suite/api-gateway — copy sang .env cho local dev
NODE_ENV=development
APP_VERSION=1.0.0
APP_HOST=0.0.0.0
AI_GATEWAY_PORT=9100

# PostgreSQL — database ioes_ai (bảng learning_paths của FR-AI-005).
# TypeORM chạy synchronize=false, nên phải áp migration bằng tay TRƯỚC khi
# khởi động, theo đúng thứ tự (V2 dùng uuid_generate_v7() do V1 định nghĩa —
# đây không phải hàm sẵn có của Postgres):
#   psql -h localhost -p 5433 -U ioes -d ioes_ai -f database/migrations/ai/V1__init_schema.sql
#   psql -h localhost -p 5433 -U ioes -d ioes_ai -f database/migrations/ai/V2__learning_paths.sql
# Cổng 5433 chứ không phải 5432: Postgres của docker compose map ra 5433.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=ioes
POSTGRES_PASSWORD=
AI_DB_NAME=ioes_ai
DB_POOL_MAX=10

# Eureka — tên đăng ký PHẢI là ai-suite, gateway route bằng lb://ai-suite
EUREKA_ENABLED=true
EUREKA_APP_NAME=ai-suite
EUREKA_HOST=localhost
EUREKA_PORT=9999
EUREKA_SERVICE_PATH=/eureka/apps/
EUREKA_INSTANCE_HOST=localhost

# ml-worker (Python FastAPI)
ML_WORKER_URL=http://localhost:9101
ML_WORKER_TIMEOUT_MS=60000
# Sinh cau hoi va sinh lo trinh goi mo hinh nhieu luot nen timeout tach rieng
ML_WORKER_GENERATE_TIMEOUT_MS=180000
ML_WORKER_LEARNING_PATH_TIMEOUT_MS=180000

# content-service (Spring Boot) - catalogue khoa hoc va ghi danh
CONTENT_SERVICE_URL=http://localhost:9001
CONTENT_SERVICE_TIMEOUT_MS=10000
CONTENT_CATALOG_PAGE_SIZE=100
CONTENT_CATALOG_MAX_PAGES=5

# Goi y khoa hoc
RECOMMENDATIONS_CACHE_TTL_SECONDS=180
RECOMMENDATIONS_DEFAULT_LIMIT=6

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_CLIENT_ID=ai-suite
KAFKA_GROUP_ID=ai-suite

# JWT — lấy từ .env gốc của monorepo, KHÔNG commit giá trị thật
JWT_SECRET=
JWT_ALGORITHM=HS256
