"""ml-worker env file for local development. Copy to .env."""

APP_ENV=local
APP_NAME=ml-worker
APP_VERSION=1.0.0
LOG_LEVEL=INFO
LOG_JSON=true

APP_HOST=0.0.0.0
APP_PORT=9101

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=ml-worker

JWT_SECRET=ioes-jwt-secret-key-must-be-at-least-256-bits-long-for-hs256-signing-algorithm
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

ML_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
ML_BATCH_SIZE=32
ML_MAX_SEQ_LENGTH=512
ML_MODEL_DEVICE=cpu

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_USER=
MILVUS_PASSWORD=
MILVUS_DATABASE=ioes_ai

OTLP_ENDPOINT=http://localhost:4317

LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=

AUTH_SERVICE_URL=http://localhost:9000
CONTENT_SERVICE_URL=http://localhost:9001
EXAM_SERVICE_URL=http://localhost:9005
API_GATEWAY_URL=http://localhost:8080

CORS_ORIGINS=http://localhost:3000,http://localhost:3001
