# ml-worker env file for local development. Copy to .env.

APP_ENV=development
APP_NAME=ml-worker
APP_VERSION=1.0.0
LOG_LEVEL=info
LOG_JSON=true

APP_HOST=0.0.0.0
APP_PORT=9101

KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_CONSUMER_GROUP=ai-suite

JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Mo hinh nhung. Ban multilingual xu ly duoc cau hoi tieng Viet tren corpus
# tieng Anh. Doi mo hinh khac so chieu la phai nap lai toan bo corpus.
EMBEDDING_MODEL=intfloat/multilingual-e5-small
BATCH_SIZE=32
MAX_SEQ_LENGTH=512
MODEL_DEVICE=cpu

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=course_embeddings

# mock | gemini | openai. mock khong goi mang, dung cho test.
LLM_PROVIDER=mock
LLM_TEMPERATURE=0.7

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-3.5-flash-lite

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# RAG
RAG_TOP_K=8
RAG_SCORE_THRESHOLD=0.70
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
# Gemini tinh ca token suy luan an vao tong, dat thap se cat cut cau tra loi.
RAG_MAX_TOKENS=1200
