{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "ignoreDeprecations": "5.0",

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    "paths": {
      "@/*": ["./src/*"],

      // pnpm resolves `@types/react-dom`'s `"@types/react": "*"` to 18.3.31,
      // so the types inside @types/react-dom/*.d.ts come from a different React
      // than the 19.0.0 this app links. Two different `ReactNode` declarations
      // make e.g. `renderToString(createElement(...))` fail to type-check.
      // Pin both specifiers to the single copy apps/web actually links.
      // Only affects tsc: vite.config.ts uses explicit resolve.alias.
      "react": ["./node_modules/@types/react"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "react-dom/*": ["./node_modules/@types/react-dom/*"]
    },

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "tests"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
