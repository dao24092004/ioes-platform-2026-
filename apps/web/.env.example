# Gốc của API Gateway (Spring Cloud Gateway).
# Web gọi /api/ai/**, /api/auth/** ... qua địa chỉ này.
VITE_API_BASE_URL=http://localhost:8080

# ============================================
# Test credentials (used ONLY by Playwright setup project and
# auth.spec.ts). Real values are placed in apps/web/.env
# (git-ignored). Missing value => the consumer SKIPs with
# reason "missing env: <NAME>". Fake fallbacks are NOT used for
# valid-login credentials; they are generated inline only for
# the deliberately-wrong-password and unknown-email mock cases.
# ============================================

# ---- Valid login (REQUIRED to run setup + auth login tests) ----
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=

TEST_STUDENT_EMAIL=
TEST_STUDENT_PASSWORD=

TEST_INSTRUCTOR_EMAIL=
TEST_INSTRUCTOR_PASSWORD=

# ---- Wrong-password mock (inline fake fallback is allowed) ----
TEST_STUDENT_PASSWORD_BAD=

# ---- Unknown-email mock (inline fake fallback is allowed) ----
TEST_STUDENT_EMAIL_UNKNOWN=